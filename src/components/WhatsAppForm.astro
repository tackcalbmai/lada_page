---
import site from '../data/site.json';
---
<form id="wa" class="card form">
<label>Имя<input name="name" required></label>
<label>Тип работы<select name="type"><option>Микрореализм</option><option>Cover-up</option></select></label>
<label>Место на теле<input name="placement"></label>
<label>Примерный размер<input name="size"></label>
<label class="full">Идея<textarea name="idea" required></textarea></label>
<button class="pill" type="submit">Открыть WhatsApp</button>
</form>
<script define:vars={{ number: site.whatsappNumber }}>
  document.querySelector('#wa')?.addEventListener('submit', (e) => {
    e.preventDefault();
    const f = new FormData(e.currentTarget);
    const msg = `Здравствуйте! Хочу обсудить татуировку.\n\nИмя: ${f.get('name')}\nТип: ${f.get('type')}\nМесто: ${f.get('placement')}\nРазмер: ${f.get('size')}\nИдея: ${f.get('idea')}`;
    window.open(`https://wa.me/${number}?text=${encodeURIComponent(msg)}`, '_blank');
  });
</script>
