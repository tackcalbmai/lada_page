---
import BaseLayout from '../../layouts/BaseLayout.astro';
import blog from '../../data/blog.json';
export function getStaticPaths(){ return blog.items.map(post => ({params:{slug:post.slug},props:{post}})); }
const { post } = Astro.props;
---
<BaseLayout title={post.title} description={post.description}><article class="section top"><div class="wrap prose"><p class="eyebrow">{post.date}</p><h1>{post.title}</h1><p class="lead">{post.description}</p><p>{post.body}</p></div></article></BaseLayout>
